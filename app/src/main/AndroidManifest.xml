<?xml version="1.0" encoding="utf-8"?>
<!--
  离线语音识别服务（系统级）。

  ## 注册方式照抄成熟开源项目
  参考 `ElishaAz/Sayboard`（Vosk 语音键盘，活跃项目）的 AndroidManifest：
  它的 RecognitionService 声明有四个关键点，本文件全部对齐：
    ① android:exported="true"                     —— 系统要能绑定
    ② <category android:name="android.intent.category.DEFAULT" />  —— isDefault 标记
    ③ android:foregroundServiceType="microphone"  —— 录音型前台服务
    ④ android:permission="android.permission.RECORD_AUDIO"  —— 限定调用方需录音权限
  另加 QUERY_ALL_PACKAGES：Sayboard 注释明确说明，缺它时**调用方**会收到
  ERROR_INSUFFICIENT_PERMISSIONS（即便调用方自己有录音权限）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 录音型前台服务（识别期间显示状态，避免被系统回收） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 参考 Sayboard：识别服务的调用方若无法被查询到，会拿到 ERROR_INSUFFICIENT_PERMISSIONS
         （即使调用方自己有麦克风权限）。声明此项以确保跨应用调用正常。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- 主界面：**不显示桌面图标**（v0.5.0，主人要求改回插件形态）。
             入口有两个，都不需要 LAUNCHER：
               · app.dsh.asr.OPEN —— 外部 App（如 DSH Mobile）用自定义 action 拉起
               · 系统「语音输入 → 识别服务 → 设置」页（recognition_service.xml 引用 SettingsActivity）
             这样它就是一个纯"系统识别服务提供者"，不占桌面。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="app.dsh.asr.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- v0.8.0：让调用方（DSH Mobile 语音服务页）能一键把本 App 设为系统
                 识别服务 / 触发自检，不必让用户自己在这两个 App 之间来回找。 -->
            <intent-filter>
                <action android:name="app.dsh.asr.SET_DEFAULT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="app.dsh.asr.CHECK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 文件识别入口：外部 App 传一段 WAV 进来，拿回文本。
             手表录音链路（S5 → PCM → 手机识别）必须走这里，因为系统
             RecognitionService 只能吃本机麦克风，无法喂入外部音频。 -->
        <activity
            android:name=".DecodeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="app.dsh.asr.DECODE_FILE" />
                <action android:name="app.dsh.asr.PREWARM" />
                <!-- ★ v0.6.0 流式识别三个动作。必须在这里声明：
                     代码里用显式 ComponentName 起服务时不需要 intent-filter，
                     但 `am start-foreground-service -n ... -a ...` 这类命令行投递，
                     以及部分 ROM 的组件解析，会因 action 未声明而报
                     `Error: Not found; no service started.` -->
                <action android:name="app.dsh.asr.STREAM_START" />
                <action android:name="app.dsh.asr.STREAM_CHUNK" />
                <action android:name="app.dsh.asr.STREAM_END" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ModelsActivity"
            android:exported="false"
            android:label="@string/models_title" />

        <!-- 系统「语音输入 → 识别服务 → 设置」入口（recognition_service.xml 引用） -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <!-- 系统识别服务。声明要点见文件顶部注释（对齐 Sayboard）。 -->
        <!-- 外部音频文件识别服务：bindService 而不是 startActivity
             —— Android 10+ 禁止后台应用启动别的 App 的 Activity（BAL_BLOCK），
             而手表触发识别时调用方必在后台。 -->
        <!-- v0.8.0：跨 App 状态查询。dsh 语音服务页靠它显示「已装 / 模型就绪 / 是否默认」，
             而不是只能判断"装没装"。 -->
        <provider
            android:name=".StatusProvider"
            android:authorities="app.dsh.asr.status"
            android:exported="true"
            android:readPermission="android.permission.INTERNET" />

        <service
            android:name=".DecodeService"
            android:exported="true"
            android:foregroundServiceType="dataSync">
            <!-- ★★★ 流式三动作必须显式声明：不声明的 action 投递会直接
                 `Error: Not found; no service started`，onStartCommand 永远收不到。
                 整段识别（DECODE_FILE）走 bindService 传参，流式走 startService 传参。 -->
            <intent-filter>
                <action android:name="app.dsh.asr.DECODE_FILE" />
                <action android:name="app.dsh.asr.STREAM_START" />
                <action android:name="app.dsh.asr.STREAM_CHUNK" />
                <action android:name="app.dsh.asr.STREAM_END" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".AsrRecognitionService"
            android:exported="true"
            android:label="@string/service_label"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter android:priority="100">
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

    </application>
</manifest>
